# CodeMate Backend Configuration
PORT=3001
HOST=0.0.0.0

# AI Provider ("gemini" | "openai" | "mock")
# When left as "mock", the backend operates with an intelligent offline competitive programming engine without needing any API key!
AI_PROVIDER=mock

# Gemini API Key (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
